# ┌──────────────────────────────────────────────────────────────────────────┐
# │  Lắc Đói — .env.docker.example                                        │
# │  Local/dev; production chạy bash deploy.sh với .env.production.       │
# │  Sao chép:  cp .env.docker.example .env.docker                        │
# │  Chạy:      docker compose --env-file .env.docker up -d --build       │
# └──────────────────────────────────────────────────────────────────────────┘

# ━━━ Ứng dụng ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
APP_NAME="Lắc Đói"
APP_ENV=local                       # production → production
APP_KEY=                            # production → BẮT BUỘC điền (xem DEPLOY.md §3)
APP_DEBUG=true                      # production → false
APP_URL=http://127.0.0.1:1113       # production → https://your-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=debug                     # production → warning

# ━━━ Database ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DB_CONNECTION=mysql
DB_HOST=host.docker.internal        # MySQL container (--profile db) → db
DB_PORT=3306
DB_DATABASE=shake_hungry
DB_USERNAME=root                    # MySQL container → lakdoi
DB_PASSWORD=                        # production → mật khẩu mạnh
DB_COLLATION=utf8mb4_vi_0900_ai_ci

# Chỉ dùng khi chạy MySQL container (--profile db):
# DB_ROOT_PASSWORD=lacdoi-root      # production → mật khẩu mạnh

# ━━━ Session / Queue / Cache ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
# SESSION_SECURE_COOKIE=true        # production → bỏ comment (cookie chỉ qua HTTPS)

# ━━━ Cổng web ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Cổng container web publish ra host (tránh xung đột các dự án khác trên VPS).
# Ví dụ:
#   127.0.0.1:1113    → local mặc định (đổi cổng dev nếu cần)
#   127.0.0.1:1113    → production VPS sau Caddy/Nginx (cổng riêng của Lắc Đói)
WEB_PORT=127.0.0.1:1113

# ━━━ Tài khoản quản trị ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Tạo ở lần khởi động đầu nếu chưa tồn tại. Production: dùng mật khẩu mạnh,
# xoá ADMIN_PASSWORD khỏi file sau lần đăng nhập đầu.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=LacDoi@2026

# ⚠️ TUYỆT ĐỐI không bật ở production — ai mở trang login cũng vào thẳng admin.
ADMIN_QUICK_LOGIN=false

# Mẫu env cho docker compose bản dev/test (DOCKER-001)
# Sao chép thành .env.docker rồi mới chạy:  cp .env.docker.example .env.docker
APP_NAME="Lắc Đói"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=shake_hungry
DB_USERNAME=lakdoi
DB_PASSWORD=lacdoi-secret
DB_ROOT_PASSWORD=lacdoi-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Tài khoản quản trị tạo ở lần khởi động đầu (khi DB trống / tài khoản chưa có).
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@lacdoi.local
ADMIN_PASSWORD=LacDoi@2026

# ⚠️ Đăng nhập nhanh vào admin KHÔNG mật khẩu — CHỈ dành cho dev cục bộ.
# Mặc định TẮT. Tuyệt đối không bật khi app có đường truy cập từ bên ngoài.
ADMIN_QUICK_LOGIN=false

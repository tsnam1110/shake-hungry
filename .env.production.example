# Mẫu env PRODUCTION cho Lắc Đói (DOCKER-001)
# Sao chép thành .env.production, điền giá trị thật, KHÔNG commit file đó.
# Sinh APP_KEY:  docker compose run --rm app php artisan key:generate --show
APP_NAME="Lắc Đói"
APP_ENV=production
APP_KEY=base64:DIEN-KHOA-THAT-VAO-DAY
APP_DEBUG=false
APP_URL=https://DIEN-DOMAIN-THAT

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=shake_hungry
DB_USERNAME=lakdoi
DB_PASSWORD=DIEN-MAT-KHAU-DB-MANH
DB_ROOT_PASSWORD=DIEN-MAT-KHAU-ROOT-MANH

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# Tài khoản quản trị tạo ở lần khởi động đầu tiên (sau đó nên xoá 2 dòng
# mật khẩu này khỏi file hoặc đổi mật khẩu trong trang quản trị).
ADMIN_NAME=Admin
ADMIN_EMAIL=DIEN-EMAIL-QUAN-TRI
ADMIN_PASSWORD=DIEN-MAT-KHAU-QUAN-TRI-MANH

# ⚠️⚠️ ADMIN_QUICK_LOGIN: nút đăng nhập nhanh vào thẳng admin KHÔNG cần
# mật khẩu. Trong production TUYỆT ĐỐI giữ false — bất kỳ ai mở được trang
# đăng nhập cũng vào thẳng được khu vực quản trị.
ADMIN_QUICK_LOGIN=false

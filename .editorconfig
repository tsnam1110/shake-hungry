root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[data/**/*.json]
indent_size = 2

# Hồ sơ quả dùng JSON compact, không newline cuối file (FRUIT-005).
[data/fruits/*.json]
insert_final_newline = false

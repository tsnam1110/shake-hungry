APP_NAME="Lắc Đói"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# CSDL: MySQL 8. Database phải tạo với CHARACTER SET utf8mb4,
# COLLATE utf8mb4_vi_0900_ai_ci (tìm kiếm không dấu + sắp xếp tiếng Việt).
# Tài khoản dùng mặc định root, không mật khẩu (kiểu Laragon).
# Xem docs/10-deployment/DEPLOYMENT.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shake_hungry
DB_USERNAME=root
DB_PASSWORD=
DB_COLLATION=utf8mb4_vi_0900_ai_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Quản trị (chỉ dùng khi triển khai Docker — entrypoint tạo tài khoản
# admin từ ba biến này nếu chưa có; xem docs/10-deployment/DEPLOY.md).
# ADMIN_PASSWORD để trống = không tạo admin tự động.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Nút đăng nhập nhanh vào admin trên trang đăng nhập quản trị.
# CHỈ bật ở môi trường dev nội bộ (mặc định tắt); mỗi lần dùng ghi log cảnh báo.
ADMIN_QUICK_LOGIN=false

VITE_APP_NAME="${APP_NAME}"
